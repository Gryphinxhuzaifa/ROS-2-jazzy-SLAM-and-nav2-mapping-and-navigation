<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="rooms">
    <physics name="1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors" />

    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.5 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- OUTER BOUNDARY WALLS -->
    <model name="maze_boundary">
      <static>true</static>
      
      <link name="wall_north">
        <pose>0 3.5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>7 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <link name="wall_south">
        <pose>0 -3.5 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>7 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <link name="wall_east">
        <pose>3.5 0 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>7 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <link name="wall_west">
        <pose>-3.5 0 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>7 0.2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7 0.2 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- INTERIOR MAZE WALLS - Creating closed loop path -->
    <model name="maze_walls">
      <static>true</static>

      <!-- Top Right Area -->
      <link name="wall_1">
        <pose>1.2 2.3 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <link name="wall_2">
        <pose>2.5 1.0 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>2.6 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.6 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <!-- Top Left Area -->
      <link name="wall_3">
        <pose>-1.2 2.3 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <link name="wall_4">
        <pose>-2.5 1.0 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>2.6 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.6 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <!-- Center Vertical Wall -->
      <link name="wall_5">
        <pose>0 0.2 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>1.8 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <!-- Right Side Vertical -->
      <link name="wall_6">
        <pose>2.0 -0.5 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>1.2 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <!-- Left Side Vertical -->
      <link name="wall_7">
        <pose>-2.0 -0.5 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>1.2 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <!-- Bottom Left Area -->
      <link name="wall_8">
        <pose>-1.5 -2.3 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.8 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <link name="wall_9">
        <pose>-2.6 -1.8 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>1.5 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <!-- Bottom Right Area -->
      <link name="wall_10">
        <pose>1.5 -2.3 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.8 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <link name="wall_11">
        <pose>2.6 -1.8 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>1.5 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <!-- Bottom Center Connection -->
      <link name="wall_12">
        <pose>0 -2.8 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <!-- Passages and connectors -->
      <link name="wall_13">
        <pose>0.8 1.5 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>1.0 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

      <link name="wall_14">
        <pose>-0.8 1.5 0.5 0 0 1.5708</pose>
        <collision name="c"><geometry><box><size>1.0 0.3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.3 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>

    </model>

  </world>
</sdf>