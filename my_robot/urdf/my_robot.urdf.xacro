<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- Package path property for both RViz and Gazebo -->
  <xacro:property name="mesh_path" value="package://my_robot/meshes" />

  <!-- =============================== -->
  <!-- BASE LINK                       -->
  <!-- =============================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/base_link.STL" />
      </geometry>
      <material name="dark_blue">
        <color rgba="0.0 0.1 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/base_link.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0077 0.0 -0.008" rpy="0 0 0" />
      <mass value="2.0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02" />
    </inertial>
  </link>

  <!-- Dummy root link for Gazebo base -->
  <link name="base_footprint" />
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
  </joint>

  <!-- =============================== -->
  <!-- WHEEL LINKS AND JOINTS          -->
  <!-- =============================== -->
  
  <!-- RR Wheel -->
  <link name="RR_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/RR_link.STL" />
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/RR_link.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-1.1878E-08 0.00737 3.0267E-08" rpy="0 0 0" />
      <mass value="0.021404" />
      <inertia ixx="8.628E-06" ixy="2.718E-12" ixz="3.53E-10" iyy="1.4515E-05" iyz="-9.519E-12" izz="8.6269E-06" />
    </inertial>
  </link>
  <joint name="RR_joint" type="continuous">
    <origin xyz="-0.043728 -0.078059 -0.0142" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="RR_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- RL Wheel -->
  <link name="RL-link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/RL-link.STL" />
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/RL-link.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-2.595E-08 -0.00737 1.972E-08" rpy="0 0 0" />
      <mass value="0.021404" />
      <inertia ixx="8.627E-06" ixy="-8.234E-12" ixz="6.533E-10" iyy="1.4515E-05" iyz="5.501E-12" izz="8.6279E-06" />
    </inertial>
  </link>
  <joint name="RL_joint" type="continuous">
    <origin xyz="-0.043318 0.07778 -0.0142" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="RL-link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- FR Wheel -->
  <link name="FR_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/FR_link.STL" />
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/FR_link.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-3.373E-08 0.00737 3.366E-09" rpy="0 0 0" />
      <mass value="0.021404" />
      <inertia ixx="8.6269E-06" ixy="9.834E-12" ixz="2.2159E-10" iyy="1.4515E-05" iyz="-1.375E-12" izz="8.628E-06" />
    </inertial>
  </link>
  <joint name="FR_joint" type="continuous">
    <origin xyz="0.047388 -0.077442 -0.0142" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="FR_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- FL Wheel -->
  <link name="FL_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/FL_link.STL" />
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_path}/FL_link.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-1.9405E-08 -0.00737 -2.553E-08" rpy="0 0 0" />
      <mass value="0.021404" />
      <inertia ixx="8.627E-06" ixy="-5.194E-12" ixz="-6.282E-10" iyy="1.4515E-05" iyz="-8.417E-12" izz="8.627E-06" />
    </inertial>
  </link>
  <joint name="FL_joint" type="continuous">
    <origin xyz="0.048214 0.076794 -0.0142" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="FL_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- =============================== -->
  <!-- LiDAR SENSOR                    -->
  <!-- =============================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.04" />
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.03" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.0 0.0 0.013" rpy="0 0 0" />
  </joint>

  <!-- =============================== -->
  <!-- GAZEBO PLUGINS & PROPERTIES     -->
  <!-- =============================== -->

  <!-- Material references for Gazebo -->
  <gazebo reference="base_link"><visual><material><ambient>0.0 0.1 0.3 1</ambient><diffuse>0.0 0.1 0.3 1</diffuse></material></visual></gazebo>
  <gazebo reference="RR_link"><visual><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></gazebo>
  <gazebo reference="RL-link"><visual><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></gazebo>
  <gazebo reference="FR_link"><visual><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></gazebo>
  <gazebo reference="FL_link"><visual><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></gazebo>

  <!-- Wheel friction properties -->
  <gazebo reference="FL_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="FR_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="RL-link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="RR_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>FL_joint</left_joint>
      <left_joint>RL_joint</left_joint>
      <right_joint>FR_joint</right_joint>
      <right_joint>RR_joint</right_joint>
      <wheel_separation>0.155</wheel_separation>
      <wheel_radius>0.03</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher for TF tree completeness -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>FL_joint</joint_name>
      <joint_name>FR_joint</joint_name>
      <joint_name>RL_joint</joint_name>
      <joint_name>RR_joint</joint_name>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- LiDAR Ray Sensor -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10.0</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
        </range>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
